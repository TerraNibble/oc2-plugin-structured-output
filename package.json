{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-structured-output",
  "version": "2.2.1",
  "description": "Structured JSON output for OpenCode prompts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugins/structured-output"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.ts",
    "./server": "./index.ts"
  },
  "files": [
    "index.ts"
  ],
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev",
    "effect": "^4.0.0"
  },
  "devDependencies": {
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta",
    "effect": "catalog:"
  }
}
